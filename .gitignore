# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
.pytest_cache/
.ruff_cache/

# Generated eval report, JSON and markdown (thresholds and the dated
# baseline are committed; CI uploads the report as an artifact)
eval/report.json
eval/report.md

# The eval's LLM response cache: answers quoting the golden set, never
# committed and never in the image
.cache/

# Teaching workspace (/teach skill), personal, never committed
.teach/

# Claude Code worktrees, created by the Agent tool, never committed
.claude/worktrees/

# Local environment files: the provisioning wizard remembers its (non-secret)
# values in .env.azure; no .env of any kind is ever committed
.env
.env.*
